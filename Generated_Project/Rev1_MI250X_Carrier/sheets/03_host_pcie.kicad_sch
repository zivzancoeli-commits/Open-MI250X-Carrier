(kicad_sch (version 20250114) (generator "open-mi250x-carrier-generator")

	(uuid "0480b466-cd3b-4442-a076-bf2e30a111aa")

	(paper "A3")

	(title_block
		(title "Open MI250X Carrier Rev1")
		(date "2026-07-07")
		(rev "0.1-prototype")
		(comment 1 "03_host_pcie")
		(comment 2 "Host PCIe")
		(comment 3 "Evidence: OCP OAM Design Spec v1.5; AMD MI250X OAM")
		(comment 4 "AMD-specific nets marked TODO — do not route until verified")
	)

	(lib_symbols
	)

(text (at 20.32 17.78 0)
	(effects (font (size 1.25 1.25)) (justify left top))
	(uuid "2bdfc479-f1ff-4ca7-9f30-b17744a884fc")
	"PURPOSE: Host PCIe Gen4 x16 edge connector to OAM host link (PET/PER).\nHOST: PCI Express Card Electromechanical Specification (CEM) Gen4 — PCIE_Ln_TX/RX_P/N lanes 0..15.\nOAM: OCP Accelerator Module Design Specification v1.5 Table 4 OAM Pinouts — PETp/n, PERp/n lanes 0..15.\nMAPPING: Host TX (PCIE_Ln_TX) → OAM PERp/n; Host RX (PCIE_Ln_RX) ← OAM PETp/n.\nAC coupling on PET path per OCP baseboard rule — cap values TODO.\nNO physical CEM slot pins or OAM connector pins assigned on this sheet.\nAMD dual-GCD lane assignment — TODO (see lane mapping notes)."
)
(text (at 20.32 95.0 0)
	(effects (font (size 1.1 1.1)) (justify left top))
	(uuid "ec009ad1-bd8c-4e7e-8a94-3be41f632b4d")
	"OCP Table 4 OAM Pinouts: PETp/n[15:0] = module TX (host RX); PERp/n[15:0] = module RX (host TX)."
)
(text (at 20.32 103.0 0)
	(effects (font (size 1.1 1.1)) (justify left top))
	(uuid "8ce0118d-9803-4792-92a0-9f2f7d3a5c59")
	"OCP Table 4 OAM Pinouts: PE_REFCLKp/n — 100 MHz PCIe reference clock."
)
(text (at 20.32 111.0 0)
	(effects (font (size 1.1 1.1)) (justify left top))
	(uuid "9dca2b13-61c9-4ff6-8f5c-58239b308c33")
	"OCP Table 4 OAM Pinouts: PERST#, SMBus_D/CLK/ALERT#, PRESNT# on Conn0."
)
(text (at 20.32 119.0 0)
	(effects (font (size 1.1 1.1)) (justify left top))
	(uuid "3a061e88-71da-4f1e-88b8-018842434078")
	"PCI Express Card Electromechanical Specification (CEM) Gen4: Host slot uses PCIE_Ln_TX_P/N and PCIE_Ln_RX_P/N per lane."
)
(text (at 20.32 127.0 0)
	(effects (font (size 1.1 1.1)) (justify left top))
	(uuid "ac3e6ec1-2b86-4543-8628-56e0711f5784")
	"CLKREQ# / WAKE#: PCIe CEM sidebands — NOT in OCP Table 4; marked TODO."
)
(text (at 20.32 135.0 0)
	(effects (font (size 1.1 1.1)) (justify left top))
	(uuid "46ca1be8-41f9-4a55-8234-352b04fc2c05")
	"AMD: GCD0/GCD1 lane bifurcation and lane index mapping — TODO."
)
(text (at 20.32 143.0 0)
	(effects (font (size 1.1 1.1)) (justify left top))
	(uuid "271b960a-17e3-4759-be0b-d1cab658d940")
	"Missing/TODO support signals: CLKREQ#, WAKE#, PRSNT2#, PWRBRK#"
)
