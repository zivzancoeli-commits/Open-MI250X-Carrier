	(paper "A3")

	(title_block
		(title "Open MI250X Carrier Rev1")
		(date "2026-07-07")
		(rev "0.1-prototype")
		(comment 1 "02_oam_interface")
		(comment 2 "OAM Interface")
		(comment 3 "Evidence: OCP OAM Design Spec v1.5; AMD MI250X OAM")
		(comment 4 "AMD-specific nets marked TODO — do not route until verified")
	)

	(lib_symbols
	)

(text (at 20.32 17.78 0)
	(effects (font (size 1.35 1.35)) (justify left top))
	(uuid "bc022322-073f-4a7a-a9c0-f557cf25304f")
	"PURPOSE: MI250X OAM mating via 2x Molex Mirror Mezz Pro (688-pin each).\nOCP: OCP Accelerator Module Design Specification v1.5 §8.1–8.3; Table 4 OAM Pinouts.\nMPN examples: 218910-1115, 218916-1115 (confirm against physical MI250X module).\nCRITICAL: KiCad pin numbers are LOGICAL indices 1..688 — NOT Molex physical pads.\nPhysical mapping: TODO — import OAM_Pinlist_Pinmap spreadsheet.\nConn0 (J1): host PCIe x16, power, SMBus, presence, SerDes 1-3 per OCP §8.2.\nConn1 (J2): 3.3V, JTAG, GPIO (AMD TODO), SerDes 4-7 per OCP §8.2.\nDo NOT route PHYS_PIN_TODO_* or GPIO_TODO_* until verified."
)
(text (at 20.32 120.0 0)
	(effects (font (size 1.15 1.15)) (justify left top))
	(uuid "02276c93-ffc0-4d84-8867-7fcc497bf3ae")
	"OCP OCP Accelerator Module Design Specification v1.5 §6.2: Mezzanine connector — Molex Mirror Mezz Pro, 90 ohm, 688-pin BGA."
)
(text (at 20.32 128.0 0)
	(effects (font (size 1.15 1.15)) (justify left top))
	(uuid "f35d91f3-9534-4526-853c-d70bca6d0b67")
	"OCP §8.1: Module uses two 688-pin Mirror Mezz Pro connectors (Conn0 + Conn1)."
)
(text (at 20.32 136.0 0)
	(effects (font (size 1.15 1.15)) (justify left top))
	(uuid "52598373-c540-4a3b-9ac1-8ae1f8630824")
	"OCP Table 4: PETp/n[15:0] host TX (module TX); AC coupling caps on carrier/baseboard."
)
(text (at 20.32 144.0 0)
	(effects (font (size 1.15 1.15)) (justify left top))
	(uuid "3e450c77-6788-41b1-bfa3-499f27b2a5c5")
	"OCP Table 4: PERp/n[15:0] host RX (module RX); AC coupling on carrier/baseboard."
)
(text (at 20.32 152.0 0)
	(effects (font (size 1.15 1.15)) (justify left top))
	(uuid "e3ad64f3-0665-48e0-9258-f4d2fe646468")
	"OCP Table 4: PE_REFCLKp/n — 100MHz PCIe Gen5 compliant reference clock."
)
(text (at 20.32 160.0 0)
	(effects (font (size 1.15 1.15)) (justify left top))
	(uuid "1c6fbf2e-5677-4151-b8f5-d6524da3a648")
	"OCP Table 4: PERST#, PRESNT#, SMBus_D/CLK/ALERT# on Conn0."
)
(text (at 20.32 168.0 0)
	(effects (font (size 1.15 1.15)) (justify left top))
	(uuid "61a96ba4-6c41-44ae-b8ce-d818f370ca59")
	"OCP §8.2 Conn1: JTAG, GPIO, SerDes 4-7 — GPIO AMD-specific; do not assign."
